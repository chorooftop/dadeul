# 필수 — 로컬 PostgreSQL 접속 URL을 입력한다.
DATABASE_URL=

# 선택 — 없으면 POST /v1/regions/resolve만 INTERNAL_ERROR/503을 반환한다.
# 카카오 디벨로퍼스의 REST API 키를 입력하며 클라이언트 앱에는 넣지 않는다.
# KAKAO_REST_API_KEY=

NODE_ENV=development
PORT=3000
TALLY_WINDOW_HOURS=2
MIN_SAMPLE_THRESHOLD=5
DAILY_CREDIT_CAP=3
RATE_LIMIT_GLOBAL_PER_MIN=120
RATE_LIMIT_BOOTSTRAP_PER_MIN=5
RATE_LIMIT_RESOLVE_PER_MIN=10
